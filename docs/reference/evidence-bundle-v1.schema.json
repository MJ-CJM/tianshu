{
  "$defs": {
    "AcceptanceCheckV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "default": "bash",
          "enum": [
            "bash",
            "lint",
            "rubric"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "rubric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "pass_threshold": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Pass Threshold",
          "type": "number"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "AcceptanceCheckV1",
      "type": "object"
    },
    "AcceptancePolicyV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AcceptanceCheckV1"
          },
          "title": "Checks",
          "type": "array"
        },
        "critic_persona_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Critic Persona Ids",
          "type": "array"
        },
        "critic_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Critic Model"
        },
        "critic_same_issue_threshold": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Critic Same Issue Threshold",
          "type": "integer"
        },
        "critic_strictness": {
          "default": "lenient",
          "enum": [
            "lenient",
            "balanced",
            "strict"
          ],
          "title": "Critic Strictness",
          "type": "string"
        },
        "escalation_levels": {
          "default": [
            "L1",
            "L2",
            "L3"
          ],
          "items": {
            "enum": [
              "L1",
              "L2",
              "L3"
            ],
            "type": "string"
          },
          "title": "Escalation Levels",
          "type": "array"
        },
        "l1_max_rounds": {
          "default": 2,
          "minimum": 0,
          "title": "L1 Max Rounds",
          "type": "integer"
        },
        "l2_max_rounds": {
          "default": 1,
          "minimum": 0,
          "title": "L2 Max Rounds",
          "type": "integer"
        },
        "l1_thinking_budget": {
          "default": 8000,
          "exclusiveMinimum": 0,
          "title": "L1 Thinking Budget",
          "type": "integer"
        },
        "l1_model_upgrade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "L1 Model Upgrade"
        },
        "l2_consultation_personas": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "L2 Consultation Personas",
          "type": "array"
        },
        "min_outer_iterations": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Min Outer Iterations",
          "type": "integer"
        },
        "max_outer_iterations": {
          "default": 5,
          "exclusiveMinimum": 0,
          "title": "Max Outer Iterations",
          "type": "integer"
        },
        "deadline_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline Seconds"
        },
        "on_exhaustion": {
          "default": "escalate",
          "enum": [
            "escalate",
            "best_effort",
            "fail"
          ],
          "title": "On Exhaustion",
          "type": "string"
        },
        "on_critic_unavailable": {
          "default": "skip",
          "enum": [
            "escalate",
            "skip"
          ],
          "title": "On Critic Unavailable",
          "type": "string"
        },
        "on_approval_timeout": {
          "default": "best_effort",
          "enum": [
            "fail",
            "best_effort"
          ],
          "title": "On Approval Timeout",
          "type": "string"
        }
      },
      "title": "AcceptancePolicyV1",
      "type": "object"
    },
    "ArtifactRefV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "redaction": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Redaction",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "root_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "digest",
        "size_bytes",
        "media_type",
        "redaction",
        "uri",
        "root_fingerprint"
      ],
      "title": "ArtifactRefV1",
      "type": "object"
    },
    "AuditorConclusionV1": {
      "additionalProperties": false,
      "properties": {
        "auditor_id": {
          "title": "Auditor Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "reason": {
          "maxLength": 4096,
          "title": "Reason",
          "type": "string"
        },
        "required_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Required Evidence",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        }
      },
      "required": [
        "auditor_id",
        "verdict",
        "reason",
        "required_evidence",
        "missing_evidence",
        "evaluated_at"
      ],
      "title": "AuditorConclusionV1",
      "type": "object"
    },
    "BudgetPolicyV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "token_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Limit"
        },
        "cost_limit_cny": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Limit Cny"
        },
        "wall_clock_seconds": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Wall Clock Seconds",
          "type": "integer"
        },
        "max_iterations": {
          "default": 20,
          "exclusiveMinimum": 0,
          "title": "Max Iterations",
          "type": "integer"
        },
        "max_concurrency": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "retry_limit": {
          "default": 0,
          "minimum": 0,
          "title": "Retry Limit",
          "type": "integer"
        }
      },
      "title": "BudgetPolicyV1",
      "type": "object"
    },
    "CapabilityDegradationV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "capability": {
          "$ref": "#/$defs/CapabilityId"
        },
        "manifest_state": {
          "enum": [
            "enforced",
            "best_effort",
            "observed",
            "unsupported"
          ],
          "title": "Manifest State",
          "type": "string"
        },
        "effective_state": {
          "enum": [
            "enforced",
            "best_effort",
            "observed",
            "unsupported"
          ],
          "title": "Effective State",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "manifest_state",
        "effective_state",
        "reason"
      ],
      "title": "CapabilityDegradationV1",
      "type": "object"
    },
    "CapabilityId": {
      "enum": [
        "action_interception",
        "workspace_control",
        "network_control",
        "secret_control",
        "budget_enforcement",
        "decision_bridge",
        "pause",
        "durable_resume",
        "event_fidelity",
        "artifact_export",
        "side_effect_receipts",
        "pre_run_restore_point",
        "governed_apply_merge"
      ],
      "type": "string"
    },
    "CapabilityRequirementsV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
