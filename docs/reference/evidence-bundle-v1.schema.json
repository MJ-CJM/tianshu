          "title": "Kind",
          "type": "string"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "actor_principal_id": {
          "title": "Actor Principal Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 4096,
          "title": "Reason",
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Hash",
          "type": "string"
        },
        "resolved_at": {
          "format": "date-time",
          "title": "Resolved At",
          "type": "string"
        }
      },
      "required": [
        "decision_request_id",
        "kind",
        "action",
        "actor_principal_id",
        "reason",
        "payload_hash",
        "resolved_at"
      ],
      "title": "DecisionEvidenceV1",
      "type": "object"
    },
    "EffectEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "intent_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intent Id",
          "type": "string"
        },
        "effect_id": {
          "title": "Effect Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "intended",
            "receipted",
            "uncertain"
