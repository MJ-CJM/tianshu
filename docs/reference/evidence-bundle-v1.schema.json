          "title": "Semantics",
          "type": "string"
        },
        "request_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Hash",
          "type": "string"
        },
        "result_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Hash"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        }
      },
      "required": [
        "intent_id",
        "effect_id",
        "status",
        "semantics",
        "request_hash",
        "reason_code"
      ],
      "title": "EffectEvidenceV1",
      "type": "object"
    },
    "EffectiveGovernanceContractV1": {
      "additionalProperties": false,
