        },
        "mandatory": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityId"
          },
          "title": "Mandatory",
          "type": "array"
        },
        "advisory": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityId"
          },
          "title": "Advisory",
          "type": "array"
        }
      },
      "title": "CapabilityRequirementsV1",
      "type": "object"
    },
    "CapabilityResolutionV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "capability": {
          "$ref": "#/$defs/CapabilityId"
        },
        "requested_mode": {
          "enum": [
            "mandatory",
            "advisory",
            "unrequested"
          ],
          "title": "Requested Mode",
          "type": "string"
        },
        "state": {
          "enum": [
            "enforced",
            "best_effort",
            "observed",
            "unsupported"
          ],
          "title": "State",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "capability",
        "requested_mode",
        "state"
      ],
      "title": "CapabilityResolutionV1",
      "type": "object"
    },
    "CheckEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "unavailable",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "command_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Fingerprint"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "output_artifact_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Artifact Digest"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "name",
        "status",
        "exit_code",
        "started_at",
        "completed_at"
      ],
      "title": "CheckEvidenceV1",
      "type": "object"
    },
    "CostEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        },
        "requested_budget": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Budget"
        },
        "effective_budget": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Budget"
        },
        "actual_cost": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Actual Cost",
          "type": "string"
        },
        "prompt_tokens": {
          "minimum": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "minimum": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "cache_read_tokens": {
          "minimum": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        }
      },
      "required": [
        "actual_cost",
        "prompt_tokens",
        "completion_tokens",
        "cache_read_tokens"
      ],
      "title": "CostEvidenceV1",
      "type": "object"
    },
    "DecisionEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "decision_request_id": {
          "title": "Decision Request Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "tool",
            "outer_loop",
            "plan_review",
            "governed_apply"
