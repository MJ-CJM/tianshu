    "history": {
      "items": {
        "$ref": "#/$defs/IterationSummaryV1"
      },
      "title": "History",
      "type": "array"
    },
    "same_issue_streak": {
      "minimum": 0,
      "title": "Same Issue Streak",
      "type": "integer"
    },
    "last_critic_issue_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Critic Issue Class"
    },
    "l1_rounds_used": {
      "minimum": 0,
      "title": "L1 Rounds Used",
      "type": "integer"
    },
    "l2_rounds_used": {
      "minimum": 0,
      "title": "L2 Rounds Used",
      "type": "integer"
    },
    "consultation_advice": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Consultation Advice"
    },
    "usage": {
      "$ref": "#/$defs/PersistedUsageSummaryV1"
    },
    "total_cost_cny": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Total Cost Cny",
      "type": "string"
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Checkpoint Ref"
    },
    "pending_decision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pending Decision Id"
    },
    "resolved_decision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Resolved Decision Id"
    },
    "side_effect_cursor": {
      "minimum": 0,
      "title": "Side Effect Cursor",
      "type": "integer"
    },
    "plan_continuation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentContinuationV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "level",
    "iteration",
    "best_output",
    "feedback",
    "steer",
    "history",
    "same_issue_streak",
    "last_critic_issue_class",
    "l1_rounds_used",
    "l2_rounds_used",
    "consultation_advice",
    "usage",
    "total_cost_cny",
    "checkpoint_ref",
    "resolved_decision_id",
    "side_effect_cursor"
  ],
  "title": "OuterLoopContinuationV1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianshu.dev/schemas/outer-loop-continuation-v1.schema.json",
  "x-pydantic-version": "2.13.0"
}
