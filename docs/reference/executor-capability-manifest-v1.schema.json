  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "manifest_id": {
      "minLength": 1,
      "title": "Manifest Id",
      "type": "string"
    },
    "manifest_version": {
      "minLength": 1,
      "title": "Manifest Version",
      "type": "string"
    },
    "adapter_id": {
      "minLength": 1,
      "title": "Adapter Id",
      "type": "string"
    },
    "display_name": {
