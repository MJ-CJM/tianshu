        "workspace_control",
        "network_control",
        "secret_control",
        "budget_enforcement",
        "decision_bridge",
        "pause",
        "durable_resume",
        "event_fidelity",
        "artifact_export",
        "side_effect_receipts",
        "pre_run_restore_point",
        "governed_apply_merge"
